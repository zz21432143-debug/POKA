{
  "name": "poka",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 43123",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && next build",
    "db:release": "node scripts/build.cjs",
    "start": "next start --hostname 0.0.0.0 --port 43123",
    "lint": "eslint",
    "test": "tsx --test src/lib/feed.test.ts src/lib/marks.test.ts src/lib/promo-rotate.test.ts src/lib/hand-review.test.ts src/lib/inventory.test.ts src/lib/growth.test.ts src/lib/nickname.test.ts src/lib/dealer-drill.test.ts src/lib/permissions.test.ts src/lib/session.test.ts src/lib/levels.test.ts src/lib/rewards.test.ts src/lib/oauth-consent.test.ts src/lib/kakao-oauth.test.ts src/lib/account-restriction.test.ts src/lib/seo.test.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "SEED_RESET=1 prisma db seed",
    "desktop": "bash desktop/open-poka.sh",
    "app": "bash desktop/open-poka.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.2",
    "dotenv": "^18.0.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
