{
  "framework": "nextjs",
  "buildCommand": "node scripts/apply-schema.cjs && prisma generate && next build",
  "crons": [
    {
      "path": "/api/cron/quiz-push",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/quiz-push?slot=evening",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/yokai-push",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/attend-push",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/content-publish",
      "schedule": "5 3 * * *"
    },
    {
      "path": "/api/cron/content-publish?slot=night",
      "schedule": "5 12 * * *"
    },
    {
      "path": "/api/cron/job-expiry",
      "schedule": "0 1 * * *"
    }
  ]
}
