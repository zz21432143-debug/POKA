// POKA — 포커/딜러 커뮤니티 스키마
// SQLite는 로컬 개발용. 이후 PostgreSQL로 전환해도 모델 구조는 동일하게 유지합니다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum BoardType {
  FREE
  RULE_QA
  SKETCH
  HAND_REVIEW
  ANONYMOUS_REVIEW
  JOBS
  PROMO
  EVENT_POSTER
  OFFICIAL_POSTER
  TALENT
  PICKUP
  SCHEDULE
}

/// 구인/구직 5종. 레거시 TALENT·PICKUP 보드 타입은 라우트 별칭으로 유지합니다.
enum JobKind {
  FIXED
  APPLY
  TEAM
  URGENT
  SEEKING
}

enum MemberKind {
  COMPANY
  INDIVIDUAL
}

enum MarkCategory {
  TEAM
  LEVEL
  SPECIAL
}

/// 상점 상위 카테고리. 마크는 Mark 테이블, 프레임·이펙트는 ProfileCosmetic.
enum CosmeticKind {
  FRAME
  EFFECT
}

model User {
  id                  String   @id @default(cuid())
  nickname            String   @unique
  passwordHash        String?
  kakaoId             String?  @unique
  resetCodeHash       String?
  resetCodeExpires    DateTime?
  profileMarkImageUrl String?
  /// 착용 중인 마크(뱃지). API/문서의 equipped_badge_id
  equippedMarkId      String?
  equippedMark        Mark?    @relation("EquippedMark", fields: [equippedMarkId], references: [id], onDelete: SetNull)
  /// 착용 중인 프로필 프레임(테두리). 추후 상점 판매
  equippedFrameId     String?
  equippedFrame       ProfileCosmetic? @relation("EquippedFrame", fields: [equippedFrameId], references: [id], onDelete: SetNull)
  /// 착용 중인 후광·모션 이펙트. 추후 상점 판매
  equippedEffectId    String?
  equippedEffect      ProfileCosmetic? @relation("EquippedEffect", fields: [equippedEffectId], references: [id], onDelete: SetNull)
  level               Int      @default(1)
  exp                 Int      @default(0)
  points              Int      @default(0)
  isDealerVerified    Boolean  @default(false)
  isAdmin             Boolean  @default(false)
  memberKind          MemberKind @default(INDIVIDUAL)
  lastPostAt          DateTime?
  lastCommentAt       DateTime?
  lastAttendanceDate  String?
  attendanceStreak    Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  posts            Post[]
  comments         Comment[]
  dailyAttendances DailyAttendance[]
  ownedMarks       UserMark[]
  ownedCosmetics   UserCosmetic[]
  votes            PostVote[]
  commentVotes     CommentVote[]
  reports          Report[]
  pollVotes        HandPollVote[]
  drillRuns        DealerDrillRun[]

  @@index([level])
  @@index([isDealerVerified])
  @@index([isAdmin])
}

model Post {
  id                 String    @id @default(cuid())
  boardType          BoardType
  /// 익명 후기도 계정은 보관하고, 화면에서만 숨깁니다.
  authorId           String?
  author             User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  title              String
  content            String
  handReviewJson     String?
  upvoteCount        Int       @default(0)
  downvoteCount      Int       @default(0)
  viewCount          Int       @default(0)
  authorIp           String?
  isAttendanceThread Boolean   @default(false)
  attendanceDate     String?   @unique
  jobKind            JobKind?
  jobLocation        String?
  /// 레거시 급여 태그. 신규 글은 jobPayType과 동일하게 채웁니다.
  jobPay             String?
  /// 근무일수: 주5일 등
  jobSchedule        String?
  jobHeadcount       String?
  jobBenefits        String?
  jobTeamGoal        String?
  jobCompanyName     String?
  jobPayType         String?
  jobPayAmount       String?
  jobWorkHours       String?
  jobExperience      String?
  jobContact         String?
  jobWorkDate        String?
  jobDateFlexible    Boolean   @default(false)
  jobGuaranteedHours String?
  jobOvertime        String?
  jobTravelPay       Boolean   @default(false)
  jobSnacks          Boolean   @default(false)
  jobDressCode       String?
  jobApplyMethod     String?
  jobApplyValue      String?
  /// Dealer / Floor / Chips / 기타 스태프 (콤마)
  jobPositions       String?
  /// 정규팀 소속 / 정기 프리랜서 / 단기 이벤트 스태프
  jobWorkType        String?
  jobAlwaysOpen      Boolean   @default(false)
  /// 대회 일정 YYYY-MM-DD (시작)
  eventDate          String?
  eventEndDate       String?
  eventPrize         String?
  eventLink          String?
  /// 검증 매장 공식 홍보
  storeVerified      Boolean   @default(false)
  /// 유료 상단 고정(추후 결제 연동)
  isPaid             Boolean   @default(false)
  /// 메인 프리미엄 배너 1~6. 비어 있으면 일반 홍보글.
  bannerSlot         Int?      @unique
  bannerImageUrl     String?
  promoLocation      String?
  promoTag           String?
  jobFilled          Boolean   @default(false)
  hidden             Boolean   @default(false)
  ratingManner       Int?
  ratingService      Int?
  ratingFacility     Int?
  ratingAtmosphere   Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  comments         Comment[]
  dailyAttendances DailyAttendance[]
  votes            PostVote[]
  reports          Report[]
  bannerSlots      BannerSlot[]
  pollVotes        HandPollVote[]

  @@index([boardType, createdAt])
  @@index([authorId])
  @@index([isAttendanceThread, attendanceDate])
  @@index([jobKind, isPaid])
  @@index([eventDate])
  @@index([jobWorkType])
  @@index([hidden, boardType, createdAt])
  @@index([authorIp, createdAt])
  @@index([upvoteCount, viewCount])
}

model Comment {
  id                String   @id @default(cuid())
  postId            String?
  post              Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId          String?
  author            User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  content           String
  isAttendanceCheck Boolean  @default(false)
  upvoteCount       Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  dailyAttendance DailyAttendance?
  votes           CommentVote[]

  @@index([postId])
  @@index([postId, upvoteCount])
  @@index([authorId, isAttendanceCheck, createdAt])
}

model CommentVote {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}

model TickerEvent {
  id        String   @id @default(cuid())
  kind      String   @unique
  message   String
  href      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model DailyAttendance {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String   @unique
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([date])
}

model HandPollVote {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  choice    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId, choice])
}

model PostVote {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Report {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  reporterIp String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())

  @@unique([postId, reporterId])
  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  kind      String
  userId    String?
  ip        String
  postId    String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([ip, createdAt])
  @@index([userId, createdAt])
}

model WriteThrottle {
  key    String   @id
  lastAt DateTime
}

/// 메인 프리미엄 배너 1~6 구좌. MANUAL은 지정 글, AUTO는 최신 홍보글.
model BannerSlot {
  slot      Int      @id
  mode      String   @default("AUTO")
  enabled   Boolean  @default(true)
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  updatedAt DateTime @updatedAt
}

/// 직판 제휴 소재. placement: A1 | A2 | A3 | SIDEBAR | NATIVE.
model SponsorUnit {
  placement  String   @id
  imageUrl   String?
  href       String   @default("/advertise")
  title      String   @default("")
  advertiser String   @default("")
  mark       String   @default("제휴")
  enabled    Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

model Mark {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  imageUrl    String
  pricePoints Int
  minLevel    Int          @default(1)
  category    MarkCategory @default(SPECIAL)
  owners      UserMark[]
  equippedBy  User[]       @relation("EquippedMark")
}

model UserMark {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  markId     String
  mark       Mark     @relation(fields: [markId], references: [id], onDelete: Cascade)
  purchasedAt DateTime @default(now())

  @@id([userId, markId])
}

/// 프레임·이펙트 상품. 마크와 분리해 착용 슬롯을 독립적으로 유지합니다.
model ProfileCosmetic {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  kind        CosmeticKind
  imageUrl    String?
  cssClass    String?
  pricePoints Int
  minLevel    Int          @default(1)
  owners      UserCosmetic[]
  equippedAsFrame  User[]  @relation("EquippedFrame")
  equippedAsEffect User[]  @relation("EquippedEffect")

  @@index([kind])
}

model UserCosmetic {
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmeticId  String
  cosmetic    ProfileCosmetic @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)
  purchasedAt DateTime        @default(now())

  @@id([userId, cosmeticId])
}

model DealerDrillRun {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String
  correct    Int
  total      Int
  durationMs Int
  createdAt  DateTime @default(now())

  @@index([kind, correct, durationMs])
  @@index([userId, createdAt])
}

model LevelExp {
  level              Int @id
  requiredExp        Int
  markPurchasePoints Int
}
