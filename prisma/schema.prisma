// POKA — 포커/딜러 커뮤니티 스키마
// 운영: Neon PostgreSQL. 로컬도 postgres URL(prisma dev 또는 Docker)을 씁니다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BoardType {
  FREE
  RULE_QA
  SKETCH
  HAND_REVIEW
  ANONYMOUS_REVIEW
  JOBS
  PROMO
  EVENT_POSTER
  OFFICIAL_POSTER
  TALENT
  PICKUP
  SCHEDULE
  NOTICE
  SUGGESTION
  /// 정보센터 TDA 룰 (공식 계정만 작성)
  TDA
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum UserRole {
  USER
  ADMIN
  MASTER
}

/// 구인/구직 5종. 레거시 TALENT·PICKUP 보드 타입은 라우트 별칭으로 유지합니다.
enum JobKind {
  FIXED
  APPLY
  TEAM
  URGENT
  SEEKING
  /// 대회 딜러 구인(행사 단위, 여러 날짜)
  TOURNAMENT
}

enum MemberKind {
  COMPANY
  INDIVIDUAL
}

enum MarkCategory {
  TEAM
  LEVEL
  SPECIAL
}

/// 상점 상위 카테고리. 마크는 Mark 테이블, 프레임·이펙트는 ProfileCosmetic.
enum CosmeticKind {
  FRAME
  EFFECT
}

model User {
  id                  String   @id @default(cuid())
  nickname            String   @unique
  passwordHash        String?
  kakaoId             String?  @unique
  googleId            String?  @unique
  email               String?  @unique
  emailVerifiedAt     DateTime?
  emailVerifyHash     String?
  emailVerifyExpires  DateTime?
  termsAcceptedAt     DateTime?
  adultConfirmedAt    DateTime?
  privacyAcceptedAt   DateTime?
  resetCodeHash       String?
  resetCodeExpires    DateTime?
  profileMarkImageUrl String?
  /// 착용 중인 마크(뱃지). API/문서의 equipped_badge_id
  equippedMarkId      String?
  equippedMark        Mark?    @relation("EquippedMark", fields: [equippedMarkId], references: [id], onDelete: SetNull)
  /// 착용 중인 프로필 프레임(테두리). 추후 상점 판매
  equippedFrameId     String?
  equippedFrame       ProfileCosmetic? @relation("EquippedFrame", fields: [equippedFrameId], references: [id], onDelete: SetNull)
  /// 착용 중인 후광·모션 이펙트. 추후 상점 판매
  equippedEffectId    String?
  equippedEffect      ProfileCosmetic? @relation("EquippedEffect", fields: [equippedEffectId], references: [id], onDelete: SetNull)
  level               Int      @default(1)
  exp                 Int      @default(0)
  points              Int      @default(0)
  isDealerVerified    Boolean  @default(false)
  isAdmin             Boolean  @default(false)
  isMaster            Boolean  @default(false)
  role                UserRole @default(USER)
  memberKind          MemberKind @default(INDIVIDUAL)
  lastPostAt          DateTime?
  lastCommentAt       DateTime?
  lastAttendanceDate  String?
  attendanceStreak    Int      @default(0)
  pointsEarnedDate    String?
  pointsEarnedToday   Int      @default(0)
  status              AccountStatus @default(ACTIVE)
  suspendedUntil      DateTime?
  banReason           String?
  signupIp            String?
  lastLoginAt         DateTime?
  withdrawnAt         DateTime?
  nicknameChangeCount Int      @default(0)
  nicknameTickets     Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  posts            Post[]
  comments         Comment[]
  dailyAttendances DailyAttendance[]
  ownedMarks       UserMark[]
  ownedCosmetics   UserCosmetic[]
  votes            PostVote[]
  commentVotes     CommentVote[]
  reports          Report[]
  pollVotes        HandPollVote[]
  drillRuns        DealerDrillRun[]
  applications     JobApplication[]
  pushSubscriptions PushSubscription[]

  @@index([level])
  @@index([isDealerVerified])
  @@index([isAdmin])
  @@index([isMaster])
  @@index([role])
  @@index([status])
}

model Post {
  id                 String    @id @default(cuid())
  boardType          BoardType
  /// 익명 후기도 계정은 보관하고, 화면에서만 숨깁니다.
  authorId           String?
  author             User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  title              String
  content            String
  handReviewJson     String?
  upvoteCount        Int       @default(0)
  downvoteCount      Int       @default(0)
  viewCount          Int       @default(0)
  authorIp           String?
  isAttendanceThread Boolean   @default(false)
  attendanceDate     String?   @unique
  jobKind            JobKind?
  jobLocation        String?
  /// 레거시 급여 태그. 신규 글은 jobPayType과 동일하게 채웁니다.
  jobPay             String?
  /// 근무일수: 주5일 등
  jobSchedule        String?
  jobHeadcount       String?
  jobBenefits        String?
  jobTeamGoal        String?
  jobCompanyName     String?
  jobPayType         String?
  jobPayAmount       String?
  jobWorkHours       String?
  jobExperience      String?
  jobContact         String?
  jobWorkDate        String?
  /// 여러 날 근무하는 공고의 마지막 근무일 YYYY-MM-DD (대회·지원 딜러)
  jobEndDate         String?
  /// 일정 목록 JSON [{date:"YYYY-MM-DD", name, headcount}] (대회·지원 딜러 여러 날짜)
  jobEvents          String?
  /// TDA 룰 등 문서 게시글에 붙인 PDF 원본 주소(/api/files/{id}). 있으면 PDF 뷰어로 보여 줍니다.
  docPdfUrl          String?
  /// 모집 마감일 YYYY-MM-DD. 지나면 자동 마감
  jobDeadline        String?
  jobDateFlexible    Boolean   @default(false)
  jobGuaranteedHours String?
  jobOvertime        String?
  jobTravelPay       Boolean   @default(false)
  /// 차비 금액(숫자 문자열). 지원 딜러·급구 공고
  jobTravelPayAmount String?
  /// 3.3% 공제 여부: "공제" | "없음" (지원 딜러·대회 딜러·급구)
  jobTaxDeduction    String?
  jobSnacks          Boolean   @default(false)
  jobDressCode       String?
  jobApplyMethod     String?
  jobApplyValue      String?
  /// Dealer / Floor / Chips / 기타 스태프 (콤마)
  jobPositions       String?
  /// 정규팀 소속 / 정기 프리랜서 / 단기 이벤트 스태프
  jobWorkType        String?
  jobAlwaysOpen      Boolean   @default(false)
  /// 대회 일정 YYYY-MM-DD (시작)
  eventDate          String?
  eventEndDate       String?
  eventPrize         String?
  eventLink          String?
  /// 검증 매장 공식 홍보
  storeVerified      Boolean   @default(false)
  /// 유료 상단 고정(추후 결제 연동)
  isPaid             Boolean   @default(false)
  /// 메인 프리미엄 배너 1~6. 비어 있으면 일반 홍보글.
  bannerSlot         Int?      @unique
  bannerImageUrl     String?
  /// 글 사진(회원 게시판, 최대 5장). 구인 글에는 넣지 않습니다.
  imageUrls          String[]  @default([])
  promoLocation      String?
  promoTag           String?
  jobFilled          Boolean   @default(false)
  hidden             Boolean   @default(false)
  /// 건의사항 등 비밀글. 본문 열람은 작성자·관리자 또는 비밀번호 확인.
  isPrivate          Boolean   @default(false)
  unlockPasswordHash String?
  ratingManner       Int?
  ratingService      Int?
  ratingFacility     Int?
  ratingAtmosphere   Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  /// 목록 정렬 기준. 등록 시각이고, 공고 끌어올리기를 하면 그 시각으로 바뀝니다.
  bumpedAt           DateTime  @default(now())

  comments         Comment[]
  dailyAttendances DailyAttendance[]
  votes            PostVote[]
  reports          Report[]
  bannerSlots      BannerSlot[]
  pollVotes        HandPollVote[]
  applications     JobApplication[]

  @@index([boardType, createdAt])
  @@index([boardType, bumpedAt])
  @@index([authorId])
  @@index([isAttendanceThread, attendanceDate])
  @@index([jobKind, isPaid])
  @@index([eventDate])
  @@index([jobWorkType])
  @@index([hidden, boardType, createdAt])
  @@index([authorIp, createdAt])
  @@index([upvoteCount, viewCount])
}

model Comment {
  id                String   @id @default(cuid())
  postId            String?
  post              Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId          String?
  author            User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  content           String
  isAttendanceCheck Boolean  @default(false)
  authorIp          String?
  upvoteCount       Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  dailyAttendance DailyAttendance?
  votes           CommentVote[]
  reports         Report[]

  @@index([postId])
  @@index([postId, upvoteCount])
  @@index([authorId, isAttendanceCheck, createdAt])
  @@index([authorIp, createdAt])
}

/// 구인 공고에 사이트 안에서 지원한 기록. 한 공고에 한 번만 지원합니다.
model JobApplication {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  applicantId String
  applicant   User     @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  message     String?
  createdAt   DateTime @default(now())

  @@unique([postId, applicantId])
  @@index([applicantId, createdAt])
}

/// 급구 알림 웹 푸시 구독. 지역을 고른 브라우저마다 한 행입니다.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  region    String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// 관리자 알림(새 광고·홍보 문의) 받기. 급구 지역 알림과 따로 켭니다.
  adminAlerts Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([region])
}

model CommentVote {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}

model TickerEvent {
  id        String   @id @default(cuid())
  kind      String   @unique
  message   String
  href      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model DailyAttendance {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String   @unique
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([date])
}

model HandPollVote {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  choice    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId, choice])
}

model PostVote {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  /// post | comment
  targetType String   @default("post")
  postId     String?
  post       Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reason     String
  reporterIp String?
  /// pending | resolved | dismissed | HIDDEN(레거시)
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  @@index([status, createdAt])
  @@index([reporterId, postId])
  @@index([reporterId, commentId])
  @@index([targetType, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  kind      String
  userId    String?
  ip        String
  postId    String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([ip, createdAt])
  @@index([userId, createdAt])
}

model WriteThrottle {
  key    String   @id
  lastAt DateTime
}

/// 메인 프리미엄 배너 1~6 구좌. MANUAL은 지정 글, AUTO는 최신 홍보글.
model BannerSlot {
  slot      Int      @id
  mode      String   @default("AUTO")
  enabled   Boolean  @default(true)
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  updatedAt DateTime @updatedAt
}

/// 직판 제휴 소재. placement: A1 | A2 | A3 | SIDEBAR | NATIVE.
model SponsorUnit {
  placement  String   @id
  imageUrl   String?
  href       String   @default("/advertise")
  title      String   @default("")
  advertiser String   @default("")
  mark       String   @default("제휴")
  enabled    Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

model Mark {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  imageUrl    String
  pricePoints Int
  minLevel    Int          @default(1)
  category    MarkCategory @default(SPECIAL)
  owners      UserMark[]
  equippedBy  User[]       @relation("EquippedMark")
}

model UserMark {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  markId     String
  mark       Mark     @relation(fields: [markId], references: [id], onDelete: Cascade)
  purchasedAt DateTime @default(now())

  @@id([userId, markId])
}

/// 프레임·이펙트 상품. 마크와 분리해 착용 슬롯을 독립적으로 유지합니다.
model ProfileCosmetic {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  kind        CosmeticKind
  imageUrl    String?
  cssClass    String?
  pricePoints Int
  minLevel    Int          @default(1)
  owners      UserCosmetic[]
  equippedAsFrame  User[]  @relation("EquippedFrame")
  equippedAsEffect User[]  @relation("EquippedEffect")

  @@index([kind])
}

model UserCosmetic {
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmeticId  String
  cosmetic    ProfileCosmetic @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)
  purchasedAt DateTime        @default(now())

  @@id([userId, cosmeticId])
}

model DealerDrillRun {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String
  correct    Int
  total      Int
  durationMs Int
  createdAt  DateTime @default(now())

  @@index([kind, correct, durationMs])
  @@index([userId, createdAt])
}

model LevelExp {
  level              Int @id
  requiredExp        Int
  markPurchasePoints Int
}

model ForbiddenWord {
  id        String   @id @default(cuid())
  word      String   @unique
  createdAt DateTime @default(now())
}

/// 단일 행(id = default)으로 운영 문구를 저장합니다.
model SiteSetting {
  id               String   @id @default("default")
  noticeBanner     String?
  footerEmail      String   @default("POKA4444444@gmail.com")
  kakaoChannelUrl  String?
  /// 관리자가 광고 문의 목록을 마지막으로 연 시각(이후 문의가 "새 문의")
  inquirySeenAt    DateTime?
  updatedAt        DateTime @updatedAt
}

/// 끈 기본 금지어. 코드에 들어 있는 기본 금지어 중 관리자가 끈 단어입니다.
model DisabledBaseWord {
  word      String   @id
  createdAt DateTime @default(now())
}

/// 사이트에 올린 이미지(대회 포스터 등). 외부 저장소 없이 DB에 바로 넣고 /api/images/{id}로 보여 줍니다.
model UploadedImage {
  id         String   @id @default(cuid())
  mime       String
  data       Bytes
  size       Int
  uploaderId String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// 큰 파일(PDF)을 3MB 조각으로 나눠 저장합니다. 서버 요청·응답 한도(4.5MB) 때문에 조각 단위로 주고받습니다.
model UploadChunk {
  fileId String
  idx    Int
  data   Bytes

  @@id([fileId, idx])
}
