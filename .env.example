# 로컬: `npx prisma dev` 가 준 postgres URL, 또는 Docker postgres
# 운영(Vercel): Neon Connect 에서 Connection pooling ON → -pooler 호스트
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Prisma migrate 용. Neon Connect 에서 Connection pooling OFF (호스트에 -pooler 없음)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# 공개 주소. 운영은 카페24에서 산 도메인.
NEXT_PUBLIC_SITE_URL="https://pokerwiki.co.kr"

# 푸터·개인정보 처리방침에 노출. 비우면 아래 기본값.
# NEXT_PUBLIC_CONTACT_EMAIL="POKA4444444@gmail.com"
# NEXT_PUBLIC_OPERATOR_NAME="POKA 관리자"

# 검색엔진 소유확인. HTML 메타 content 값만 넣습니다. 비워도 됩니다.
# 코드에 직접 넣을 때는 src/lib/seo.ts 의 SEARCH_ENGINE_VERIFICATION 도 같습니다.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# NEXT_PUBLIC_NAVER_SITE_VERIFICATION=""

# 세션·동의 쿠키 서명. 운영에서는 긴 무작위 문자열을 넣으세요.
# SESSION_SECRET=""

# 카카오 로그인. Redirect URI 를 카카오 개발자 콘솔에도 등록하세요.
# https://pokerwiki.co.kr/api/auth/kakao/callback
# KAKAO_REST_API_KEY=""
# KAKAO_CLIENT_SECRET=""
# KAKAO_REDIRECT_URI="https://pokerwiki.co.kr/api/auth/kakao/callback"
# 마스터(POKA) 계정에 연결할 카카오 회원번호. 로그인 후 /account 에서 확인할 수 있습니다.
# MASTER_KAKAO_ID=""
# MASTER_KAKAO_EMAIL=""

# 구글 로그인. Redirect URI 를 Google Cloud OAuth 클라이언트에도 등록하세요.
# https://pokerwiki.co.kr/api/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="https://pokerwiki.co.kr/api/auth/google/callback"

# Google Analytics 4. 비우면 추적 스크립트를 넣지 않습니다.
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Google AdSense. 비우면 A칸·본문·사이드바 하단에 데모 소재가 뜹니다.
# NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-xxxxxxxxxxxxxxxx"
# NEXT_PUBLIC_ADSENSE_SLOT_POST_TOP="0000000001"
# NEXT_PUBLIC_ADSENSE_SLOT_POST_BOTTOM="0000000002"
# NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR="0000000003"
# NEXT_PUBLIC_ADSENSE_SLOT_A1="0000000004"
# NEXT_PUBLIC_ADSENSE_SLOT_A2="0000000005"
# NEXT_PUBLIC_ADSENSE_SLOT_A3="0000000006"
