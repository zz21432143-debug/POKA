# 로컬: `npx prisma dev` 가 준 postgres URL, 또는 Docker postgres
# 운영(Vercel): Neon Connect 에서 Connection pooling ON → -pooler 호스트
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Prisma migrate 용. Neon Connect 에서 Connection pooling OFF (호스트에 -pooler 없음)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# 공개 주소. 운영은 카페24에서 산 도메인.
NEXT_PUBLIC_SITE_URL="https://pokerwiki.co.kr"

# 세션 쿠키 서명. 운영에서는 긴 무작위 문자열을 넣으세요.
# SESSION_SECRET=""

# 카카오 로그인. 비우면 노란 버튼은 안내만 하고 가짜 계정으로 들어가지 않습니다.
# 카카오 개발자 콘솔 Redirect URI: https://pokerwiki.co.kr/api/auth/kakao/callback
# KAKAO_REST_API_KEY=""
# KAKAO_CLIENT_SECRET=""
# KAKAO_REDIRECT_URI="https://pokerwiki.co.kr/api/auth/kakao/callback"

# Google AdSense. 비우면 A칸·본문·사이드바 하단에 데모 소재가 뜹니다.
# NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-xxxxxxxxxxxxxxxx"
# NEXT_PUBLIC_ADSENSE_SLOT_POST_TOP="0000000001"
# NEXT_PUBLIC_ADSENSE_SLOT_POST_BOTTOM="0000000002"
# NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR="0000000003"
# NEXT_PUBLIC_ADSENSE_SLOT_A1="0000000004"
# NEXT_PUBLIC_ADSENSE_SLOT_A2="0000000005"
# NEXT_PUBLIC_ADSENSE_SLOT_A3="0000000006"
